# Copy to a shell environment. Do not commit real values.
# Leave both WorkOS variables unset to use local identity mode (Development and Testing only).

WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Optional. Defaults to https://api.workos.com.
WORKOS_ISSUER=
# Optional. When set, access tokens must include this audience.
WORKOS_TOKEN_AUDIENCE=
# Optional. Applied to the example Acme Robotics domain row during demo seed.
WORKOS_ORGANIZATION_ID=
WORKOS_SSO_DOMAIN=

# Local Postgres. Docker Compose sets this for the api service.
ConnectionStrings__ControlPlane=Host=localhost;Port=5432;Database=d2d_control;Username=d2d;Password=d2d_dev_password

# Leave unset in Development to keep evidence on local disk and collection in-process.
# Production and Staging require both, and Storage__ObjectLock=true.
TEMPORAL_ADDRESS=
Storage__Endpoint=
Storage__AccessKey=
Storage__SecretKey=
Storage__Bucket=d2d-evidence
Storage__ForcePathStyle=true
Storage__ObjectLock=false
Storage__Region=us-east-1

# 32 bytes, base64. Required before a Google refresh token can be stored.
TENANT_DATA_KEY=

# AWS collector. Customers trust this role. Do not store customer access keys.
AWS_COLLECTOR_ROLE_ARN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
