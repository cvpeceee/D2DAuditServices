# Copy to a shell environment. Do not commit real values.
# Leave both WorkOS variables unset to use local identity mode (Development and Testing only).

WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Optional. Defaults to https://api.workos.com.
WORKOS_ISSUER=
# Optional. When set, access tokens must include this audience.
WORKOS_TOKEN_AUDIENCE=
# Optional. Applied to the example Acme Robotics domain row during demo seed.
WORKOS_ORGANIZATION_ID=
WORKOS_SSO_DOMAIN=

# Local Postgres. Docker Compose sets this for the api service.
ConnectionStrings__ControlPlane=Host=localhost;Port=5432;Database=d2d_control;Username=d2d;Password=d2d_dev_password
