<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\D2DAudit.Application\D2DAudit.Application.csproj" />
    <ProjectReference Include="..\D2DAudit.Domain\D2DAudit.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\content\frameworks\*.json" Link="content\frameworks\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\seed\client.json" Link="seed\client.json" LogicalName="client.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.CloudTrail" Version="4.0.101.8" />
    <PackageReference Include="AWSSDK.IdentityManagement" Version="4.0.103.12" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.6" />
    <PackageReference Include="AWSSDK.SecurityToken" Version="4.0.101.6" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageReference Include="Parquet.Net" Version="6.1.0" />
    <PackageReference Include="Temporalio" Version="1.21.0" />
    <PackageReference Include="Temporalio.Extensions.Hosting" Version="1.21.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.13" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
