  "components": {
    "schemas": {
      "ActivityDto": {
        "required": [
          "at",
          "action",
          "result",
          "detail",
          "actorEmail",
          "ipAddress"
        ],
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "action": {
            "type": "string"
          },
          "result": {
            "type": "string"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "actorEmail": {
            "type": [
              "null",
              "string"
            ]
          },
          "ipAddress": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AssignOwnerRequest": {
        "required": [
          "ownerName",
          "ownerEmail"
        ],
        "type": "object",
        "properties": {
          "ownerName": {
            "type": [
              "null",
              "string"
            ]
          },
          "ownerEmail": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AuditSummary": {
        "required": [
          "name",
          "firm",
          "frameworkKey",
          "fieldworkOn",
          "openItems",
          "samplesDue"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "firm": {
            "type": "string"
          },
          "frameworkKey": {
            "type": "string"
          },
          "fieldworkOn": {
            "type": "string",
            "format": "date"
          },
          "openItems": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "samplesDue": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "AuthBody": {
        "required": [
          "ok",
          "errorCode",
          "user",
          "tenants",
          "mfaRequired",
          "pendingAuthenticationToken",
          "challengeId",
          "factors"
        ],
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "errorCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "user": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/UserSummary"
              }
            ]
          },
          "tenants": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/TenantMembershipSummary"
            }
          },
          "mfaRequired": {
            "type": "boolean"
          },
          "pendingAuthenticationToken": {
            "type": [
              "null",
              "string"
            ]
          },
          "challengeId": {
            "type": [
              "null",
              "string"
            ]
          },
          "factors": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/MfaFactor"
            }
          }
        }
      },
      "AuthModeResponse": {
        "required": [
          "mode",
          "localBanner",
          "exampleEmails"
        ],
        "type": "object",
        "properties": {
          "mode": {
            "type": "string"
          },
          "localBanner": {
            "type": "boolean"
          },
          "exampleEmails": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AuthorizeBody": {
        "required": [
          "provider",
          "redirectUri",
          "state",
          "email"
        ],
        "type": "object",
        "properties": {
          "provider": {
            "type": "string"
          },
          "redirectUri": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AutomatedTestDto": {
        "required": [
          "id",
          "key",
          "name",
          "controlCode",
          "outcome",
          "detail",
          "remediation",
          "requirements"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "controlCode": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "remediation": {
            "type": "string"
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CallbackBody": {
        "required": [
          "code",
          "redirectUri"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "redirectUri": {
            "type": "string"
          }
        }
      },
      "ConnectIntegrationRequest": {
        "required": [
          "roleArn",
          "domain",
          "installationId",
          "code",
          "state",
          "redirectUri"
        ],
        "type": "object",
        "properties": {
          "roleArn": {
            "type": [
              "null",
              "string"
            ]
          },
          "domain": {
            "type": [
              "null",
              "string"
            ]
          },
          "installationId": {
            "type": [
              "null",
              "string"
            ]
          },
          "code": {
            "type": [
              "null",
              "string"
            ]
          },
          "state": {
            "type": [
              "null",
              "string"
            ]
          },
          "redirectUri": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ConnectResponse": {
        "required": [
          "integration",
          "authorizationUrl",
          "trustPolicy",
          "permissionPolicy"
        ],
        "type": "object",
        "properties": {
          "integration": {
            "$ref": "#/components/schemas/IntegrationDto"
          },
          "authorizationUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "trustPolicy": {
            "type": [
              "null",
              "string"
            ]
          },
          "permissionPolicy": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ControlDetail": {
        "required": [
          "code",
          "title",
          "description",
          "status",
          "ownerName",
          "ownerEmail",
          "frequency",
          "mappings",
          "tests",
          "evidence"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "ownerName": {
            "type": [
              "null",
              "string"
            ]
          },
          "ownerEmail": {
            "type": [
              "null",
              "string"
            ]
          },
          "frequency": {
            "type": "string"
          },
          "mappings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ControlMappingDto"
            }
          },
          "tests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ControlTestDto"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvidenceDto"
            }
          }
        }
      },
      "ControlHealth": {
        "required": [
          "passing",
          "failing",
          "dueSoon",
          "needsEvidence",
          "manual",
          "notStarted"
        ],
        "type": "object",
        "properties": {
          "passing": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "failing": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "dueSoon": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "needsEvidence": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "manual": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "notStarted": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ControlListItem": {
        "required": [
          "code",
          "title",
          "status",
          "ownerName",
          "ownerEmail",
          "frequency",
          "testsPassing",
          "testsTotal",
          "frameworks"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "ownerName": {
            "type": [
